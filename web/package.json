{
  "name": "bet-football-web",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "openapi-typescript ../openapi.yaml -o src/schema.d.ts",
    "dev": "npm run gen && vite",
    "typecheck": "npm run gen && tsc --noEmit",
    "build": "npm run typecheck && vite build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/fira-sans-condensed": "5.3.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
